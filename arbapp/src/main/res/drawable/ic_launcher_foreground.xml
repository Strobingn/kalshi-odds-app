<?xml version="1.0" encoding="utf-8"?>
<!-- Arb Hunter: two arrows crossing (buy one side, buy the other, lock the
     spread). White over gold on dark teal. Content stays inside the 66dp
     adaptive-icon safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Gold arrow: top-left to bottom-right. -->
    <path
        android:strokeColor="#F6C85F"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M32,32 L70,70" />
    <path
        android:fillColor="#F6C85F"
        android:pathData="M78,78 L74.4,64.6 L64.6,74.4 Z" />
    <!-- Teal gap so the white arrow reads as crossing over. -->
    <path
        android:strokeColor="#0B4F4A"
        android:strokeWidth="12"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"
        android:pathData="M46,62 L62,46" />
    <!-- White arrow: bottom-left to top-right. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M32,76 L70,38" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M78,30 L64.6,33.6 L74.4,43.4 Z" />
</vector>
