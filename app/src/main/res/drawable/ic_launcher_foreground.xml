<?xml version="1.0" encoding="utf-8"?>
<!-- Bitcoin Claude: a bitcoin B inside an open ring (the C).
     Content stays inside the 66dp adaptive-icon safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- C: open ring, amber. -->
    <path
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M74.68,36.64 A27,27 0 1 0 74.68,71.36">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="27"
                android:endX="70"
                android:endY="81">
                <item android:offset="0" android:color="#FFFFC247" />
                <item android:offset="1" android:color="#FFF7931A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- B: stem and two bowls. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M47,40.5 V67.5 M47,40.5 H57 a6.75,6.75 0 0 1 0,13.5 H47 M47,54 H59 a6.75,6.75 0 0 1 0,13.5 H47" />
    <!-- The two bitcoin ticks, top and bottom. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M51.5,34.5 V40 M58,34.5 V40 M51.5,68 V73.5 M58,68 V73.5" />
</vector>
