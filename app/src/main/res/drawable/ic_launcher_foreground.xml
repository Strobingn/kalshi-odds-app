<?xml version="1.0" encoding="utf-8"?>
<!-- Claude Bitcoin: a bitcoin coin (app orange) with a B and the two ticks,
     over a rising green line. Colours are the app theme's AccentOrange, Bg, UpColor.
     Content stays inside the 66dp adaptive-icon safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Coin. -->
    <path
        android:fillColor="#D29922"
        android:pathData="M54,22 a25,25 0 1 0 0.001,0 z" />
    <!-- B: stem and two bowls. -->
    <path
        android:strokeColor="#0D1117"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M47,35.5 V59.5 M47,35.5 H56 a6,6 0 0 1 0,12 H47 M47,47.5 H58 a6,6 0 0 1 0,12 H47" />
    <!-- Bitcoin ticks. -->
    <path
        android:strokeColor="#0D1117"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M51.5,30 V35.5 M57.5,30 V35.5 M51.5,59.5 V65 M57.5,59.5 V65" />
    <!-- Rising line. -->
    <path
        android:strokeColor="#3FB950"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M28,83 L42,76 L51,80 L66,70 L80,73" />
</vector>
