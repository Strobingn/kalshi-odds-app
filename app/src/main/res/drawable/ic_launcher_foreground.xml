<?xml version="1.0" encoding="utf-8"?>
<!-- Dip Hunter Claude: price dips, the dip is marked, then it rebounds up.
     Content stays inside the 66dp adaptive-icon safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Price line: down into the dip, then up to the top right. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M24,46 L33,38 L45,66 L56,52 L64,58 L77,38" />
    <!-- Arrowhead on the rebound. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M83,29 L82,44 L70,36 Z" />
    <!-- The dip, marked. -->
    <path
        android:fillColor="#FFB020"
        android:pathData="M45,66 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    <path
        android:fillColor="#14213D"
