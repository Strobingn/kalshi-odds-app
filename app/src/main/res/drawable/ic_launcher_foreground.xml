<?xml version="1.0" encoding="utf-8"?>
<!-- Mis Bitcoin foreground: a market-blue coin with three rising candlesticks
     (the model's trade), over the app's dark gradient. Distinct from the
     Claude build's orange ฿ coin. Colours are the app theme's AccentBlue,
     OnAccentDark, UpColor. Content stays inside the 66dp adaptive-icon safe
     zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Coin. -->
    <path
        android:fillColor="#58A6FF"
        android:pathData="M54,25 a25,25 0 1 0 0.001,0 z" />

    <!-- Candle 1 (down-open, small body). -->
    <path
        android:fillColor="#0D1117"
        android:pathData="M41.5,52 h5 v7 h-5 z" />
    <path
        android:strokeColor="#0D1117"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M44,48 V52 M44,59 V62" />

    <!-- Candle 2 (up body). -->
    <path
        android:fillColor="#0D1117"
        android:pathData="M51.5,44.5 h5 v7.5 h-5 z" />
    <path
        android:strokeColor="#0D1117"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,40.5 V44.5 M54,52 V56" />

    <!-- Candle 3 (up body, breakout above the coin's midline). -->
    <path
        android:fillColor="#0D1117"
        android:pathData="M61.5,36.5 h5 v7.5 h-5 z" />
    <path
        android:strokeColor="#0D1117"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M64,32.5 V36.5 M64,44 V48" />

    <!-- Rising guide under the candles. -->
    <path
        android:strokeColor="#0D1117"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M40,63 L50,60.5 L58,57 L68,52.5" />

    <!-- Two ticks: the market the candles trade against. -->
    <path
        android:strokeColor="#3FB950"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M30,84 V78 M33,84 V78 M75,84 V78 M78,84 V78" />
</vector>
